mandarin-practice-*.json
SOFTWARE-QA-mandarin-practice-*.json

# Public source release: local experimental records and private evaluation keys.
# Preserve these on disk; only the fully synthetic math audit is versioned.
/runs/*
!/runs/mathematical-audit-v1/
**/analyst-key.json
**/*private-key*
evaluation/**/START.html
evaluation/**/QA.html
evaluation/**/exports/
evaluation/**/answers/
evaluation/**/annotations/
*.pem
*.key
*.p12
*.pfx

